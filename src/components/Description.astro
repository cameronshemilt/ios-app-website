---
import { getAppStoreData } from "../lib/appstore";
import { getSettings } from "../lib/settings";

const settings = getSettings();
const appData = await getAppStoreData(settings.appID);
const description = appData.description.trim();
---

{
  description && (
    <section class="w-full px-6 py-12 md:py-16">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-6">
          Description
        </h2>
        <div class="text-lg leading-8 text-gray-600 dark:text-gray-300 whitespace-pre-line">
          {description}
        </div>
      </div>
    </section>
  )
}
