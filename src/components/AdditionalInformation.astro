---
import { getAppStoreData } from "../lib/appstore";
import { getSettings } from "../lib/settings";

const settings = getSettings();
const appData = await getAppStoreData(settings.appID);

function formatFileSize(fileSizeBytes: string) {
  const bytes = Number(fileSizeBytes);
  if (!Number.isFinite(bytes) || bytes <= 0) {
    return "";
  }

  const megabytes = bytes / 1024 / 1024;
  return `${new Intl.NumberFormat("en", {
    maximumFractionDigits: megabytes >= 10 ? 0 : 1,
  }).format(megabytes)} MB`;
}

function formatLanguages(languageCodes: string[]) {
  if (languageCodes.length === 0) {
    return "";
  }

  const languageNames = new Intl.DisplayNames(["en"], { type: "language" });
  return languageCodes
    .map((languageCode) => languageNames.of(languageCode) || languageCode)
    .join(", ");
}

function formatCompatibility(minimumOsVersion: string) {
  if (!minimumOsVersion) {
    return "";
  }

  return `Requires ${minimumOsVersion} or later`;
}

const informationItems = [
  {
    label: "Size",
    value: formatFileSize(appData.fileSizeBytes),
  },
  {
    label: "Category",
    value: appData.primaryGenreName || appData.genres[0] || "",
  },
  {
    label: "Compatibility",
    value: formatCompatibility(appData.minimumOsVersion),
  },
  {
    label: "Languages",
    value: formatLanguages(appData.languageCodesISO2A),
  },
  {
    label: "Age Rating",
    value: appData.contentAdvisoryRating,
  },
  {
    label: "Price",
    value: appData.formattedPrice,
  },
  {
    label: "Provider",
    value: appData.sellerName,
  },
  {
    label: "Version",
    value: appData.version,
  },
].filter((item) => item.value);
---

{
  informationItems.length > 0 && (
    <section class="w-full px-6 py-12 md:py-16">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-8">
          Information
        </h2>
        <dl class="grid grid-cols-1 md:grid-cols-2 md:gap-x-10">
          {informationItems.map((item) => (
            <div class="border-b border-gray-200 dark:border-gray-800 py-5">
              <dt class="text-lg font-semibold text-gray-500 dark:text-gray-400">
                {item.label}
              </dt>
              <dd class="mt-1 text-xl text-gray-900 dark:text-gray-100">
                {item.value}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )
}
