---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="inline-flex items-center gap-2 bg-[var(--color-accent)] hover:opacity-90 text-[var(--color-accent-foreground)] font-semibold px-6 py-3 rounded-full transition-opacity"
>
  <span
    class="w-5 h-5 bg-current [mask:url('/app-store.svg')_center/contain_no-repeat] [-webkit-mask:url('/app-store.svg')_center/contain_no-repeat]"
    aria-hidden="true"
  ></span>
  Download on the App Store
</a>
