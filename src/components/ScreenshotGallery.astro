---
import { Image } from "astro:assets";
import { getAppStoreData } from "../lib/appstore";
import { getSettings } from "../lib/settings";

const settings = getSettings();
const appData = await getAppStoreData(settings.appID);
const appName = settings.title || appData.trackName;
const screenshots = appData.screenshotUrls;
---

{
  screenshots.length > 0 && (
    <section class="w-full px-6 py-12 md:py-16">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-6">
          Screenshots
        </h2>
        <div class="flex gap-4 md:gap-6 overflow-x-auto pb-4 snap-x snap-mandatory">
          {screenshots.map((src, index) => (
            <Image
              src={src}
              alt={`${appName} screenshot ${index + 1}`}
              inferSize
              class="snap-start shrink-0 rounded-3xl max-h-[560px] w-auto shadow-sm"
              loading="lazy"
            />
          ))}
        </div>
      </div>
    </section>
  )
}
