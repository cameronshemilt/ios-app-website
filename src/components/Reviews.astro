---
import { getAppStoreData } from "../lib/appstore";
import { getSettings } from "../lib/settings";

const settings = getSettings();
const appData = await getAppStoreData(settings.appID);
const rating = appData.averageUserRating;
const ratingCount = appData.userRatingCount;
const hasRatings = ratingCount > 0 && rating > 0;
const roundedRating = Math.round(rating * 10) / 10;
const fullStars = Math.round(rating);
const stars = Array.from({ length: 5 }, (_, index) =>
  index < fullStars ? "★" : "☆",
).join("");
const ratingCountLabel = `${new Intl.NumberFormat("en").format(ratingCount)} ${
  ratingCount === 1 ? "rating" : "ratings"
}`;
---

<section class="w-full px-6 py-12 md:py-16">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-8">
      Reviews
    </h2>
    {
      hasRatings ? (
        <div class="border-y border-gray-200 dark:border-gray-800 py-6">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="text-5xl font-bold tracking-tight">{roundedRating}</p>
              <p class="mt-2 text-xl tracking-wide text-gray-500 dark:text-gray-400">
                {stars}
              </p>
            </div>
            <p class="text-lg text-gray-500 dark:text-gray-400">
              {ratingCountLabel}
            </p>
          </div>
        </div>
      ) : (
        <div class="border-y border-gray-200 dark:border-gray-800 py-6">
          <p class="text-xl text-gray-500 dark:text-gray-400">
            No ratings yet.
          </p>
        </div>
      )
    }
  </div>
</section>
