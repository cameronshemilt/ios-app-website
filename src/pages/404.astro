---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="404 - Page Not Found" description="The page you are looking for does not exist.">
  <main class="flex-1 px-6 py-16 flex items-center justify-center">
    <div class="text-center max-w-xl">
      <p class="text-sm uppercase tracking-widest text-gray-500 dark:text-gray-400 mb-4">404</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">Page Not Found</h1>
      <p class="text-gray-600 dark:text-gray-300 mb-8">
        The page you requested could not be found.
      </p>
      <a
        href="/"
        class="inline-flex items-center justify-center rounded-full bg-[var(--color-accent)] text-white font-semibold px-6 py-3 hover:opacity-90 transition-opacity"
      >
        Go Home
      </a>
    </div>
  </main>
  <Footer />
</BaseLayout>
