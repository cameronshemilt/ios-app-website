---
import "../styles/global.css";
import { getSettings } from "../lib/settings";
import { getAppStoreData } from "../lib/appstore";
import { existsSync } from "node:fs";
import { resolve } from "node:path";

interface Props {
  title?: string;
  description?: string;
}

const settings = getSettings();
const appData = await getAppStoreData(settings.appID);

const pageTitle = Astro.props.title || settings.title || appData.trackName;
const description = Astro.props.description || settings.subheadline || "";
const ogDescription = settings.subheadline || description;
const hasLocalIcon = existsSync(resolve(process.cwd(), "public/appicon.png"));
const iconImage = hasLocalIcon ? "/appicon.png" : appData.iconUrl;
const siteUrl = settings.siteUrl || Astro.site || Astro.url;
const ogImage = new URL("/og.png", siteUrl).toString();
const accentColor = settings.accentColor;
const accentColorDark = settings.accentColorDark;
const LIGHT_BACKGROUND_LUMINANCE = 0.4;

function expandHex(hex: string) {
  return hex.length === 3
    ? hex
        .split("")
        .map((char) => char + char)
        .join("")
    : hex;
}

function readableForegroundFor(background: string) {
  const hex = background.trim().replace(/^#/, "");
  if (!/^(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(hex)) return "#ffffff";

  const value = expandHex(hex);
  const channels = [0, 2, 4].map((index) => {
    const channel = parseInt(value.slice(index, index + 2), 16) / 255;
    return channel <= 0.03928
      ? channel / 12.92
      : Math.pow((channel + 0.055) / 1.055, 2.4);
  });

  const luminance =
    0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2];

  // Prefer white for saturated brand colors; switch to dark text for light accents.
  return luminance > LIGHT_BACKGROUND_LUMINANCE ? "#111827" : "#ffffff";
}

const accentForeground = readableForegroundFor(accentColor);
const accentForegroundDark = readableForegroundFor(accentColorDark);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={pageTitle} />
    {ogDescription && <meta property="og:description" content={ogDescription} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="apple-itunes-app" content={`app-id=${settings.appID}`} />
    <link rel="icon" href={iconImage} type="image/png" />
    <style define:vars={{ accentColor, accentColorDark, accentForeground, accentForegroundDark }}>
      :root {
        --color-accent: var(--accentColor);
        --color-accent-dark: var(--accentColorDark);
        --color-accent-foreground: var(--accentForeground);
        --color-accent-foreground-dark: var(--accentForegroundDark);
      }

      .dark {
        --color-accent: var(--color-accent-dark);
        --color-accent-foreground: var(--color-accent-foreground-dark);
      }
    </style>
    <script is:inline>
      if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body class="bg-white dark:bg-black text-gray-900 dark:text-gray-100 min-h-screen flex flex-col">
    <slot />
  </body>
</html>
